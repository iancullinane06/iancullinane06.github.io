---
layout: null
---
[
{% assign doc_pages = site.pages | where_exp: "p", "p.path contains 'docs/'" | where_exp: "p", "p.name contains '.md'" | sort: 'nav_order' %}
{% assign example_pages = site.pages | where_exp: "p", "p.path contains 'examples/'" | where_exp: "p", "p.name contains '.md'" | sort: 'nav_order' %}
{% assign doc_pages = doc_pages | concat: example_pages %}
{% for doc in doc_pages %}
  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "content": {{ doc.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
